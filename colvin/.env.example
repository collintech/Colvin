NODE_ENV=development

# Browser / API
WEB_PORT=5173
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_DB=colvin
POSTGRES_USER=colvin_app
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

# Docker-internal application connection. The hostname `postgres` resolves on
# the Docker Compose network.
DATABASE_URL=postgresql://colvin_app:change-this-postgres-password@postgres:5432/colvin

# Host-side migration connection. `npm run db:migrate` runs from your terminal,
# so it reaches PostgreSQL through the published localhost port.
MIGRATION_DATABASE_URL=postgresql://colvin_app:change-this-postgres-password@localhost:5432/colvin

# Redis
REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379
# Docker-internal cache connection.
REDIS_URL=redis://:change-this-redis-password@redis:6379
# Host-side integration-test connection.
INTEGRATION_REDIS_URL=redis://:change-this-redis-password@localhost:6379
VEHICLE_CACHE_TTL_SECONDS=3600

# PostgreSQL pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_REUSE_GRACE_SECONDS=3
BCRYPT_ROUNDS=12

# Internal service authentication
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
VIN_DECODER_URL=http://vin-decoder:8081
HISTORY_SERVICE_URL=http://history-service:8082

# Logging
LOG_LEVEL=info

# Distributed authentication abuse protection (Redis-backed)
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REFRESH_IP_LIMIT=120
AUTH_REFRESH_WINDOW_SECONDS=300
AUTH_LIMIT_NAMESPACE=default

# Account lifecycle / transactional email
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MIN_RESPONSE_MS=500
# Production requires `hibp`; tests may use `disabled`.
PASSWORD_COMPROMISE_CHECK=disabled
PASSWORD_COMPROMISE_TIMEOUT_MS=4000
EMAIL_VERIFY_TTL_HOURS=24
# Use `resend` in production. `test` is accepted only by the integration harness.
EMAIL_PROVIDER=test
EMAIL_DELIVERY_ATTEMPTS=2
EMAIL_DELIVERY_TIMEOUT_MS=10000
RESEND_API_KEY=
EMAIL_FROM="Colvin <no-reply@example.com>"
ACCOUNT_WEB_URL=http://localhost:5173
AUTH_ACCOUNT_ACTION_ACCOUNT_LIMIT=5
AUTH_ACCOUNT_ACTION_IP_LIMIT=20
AUTH_ACCOUNT_ACTION_WINDOW_SECONDS=3600

# Gate 6 - VIN specification providers
# local = built-in validation/WMI hints only; hybrid = Vincario with local fallback; vincario = Vincario required.
VIN_PROVIDER_MODE=local
VIN_PROVIDER_TIMEOUT_MS=4000
VINCARIO_BASE_URL=https://api.vincario.com/3.2
VINCARIO_API_KEY=
VINCARIO_SECRET_KEY=
